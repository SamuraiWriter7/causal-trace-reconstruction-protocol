{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:causal-observation:0.4.0",
  "title": "Causal Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "observation_id",
    "origin",
    "outcome",
    "evidence",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "record_type": {
      "const": "causal-observation"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "$ref": "#/$defs/state"
    },
    "outcome": {
      "$ref": "#/$defs/state"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "context": {
      "type": "object"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "description"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "description",
        "reliability"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "observation",
            "log",
            "document",
            "testimony",
            "measurement",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string"
        },
        "reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
