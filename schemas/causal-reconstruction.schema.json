{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:causal-reconstruction:0.2.0",
  "title": "Causal Reconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "reconstruction_id",
    "observation_id",
    "forward_trace_ids",
    "backward_trace_ids",
    "claim_level",
    "candidate_hypotheses",
    "reconstruction_status",
    "unresolved_gaps",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_type": {
      "const": "causal-reconstruction"
    },
    "reconstruction_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "forward_trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backward_trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_level": {
      "const": "hypothesis"
    },
    "candidate_hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateHypothesis"
      }
    },
    "reconstruction_status": {
      "enum": [
        "converged",
        "partial",
        "ambiguous",
        "no-convergence"
      ]
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "candidateHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "statement",
        "meeting_points",
        "candidate_path",
        "evidence_refs",
        "contradictions",
        "unresolved_gaps",
        "confidence",
        "status"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "meeting_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meetingPoint"
          }
        },
        "candidate_path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathSegment"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contradiction"
          }
        },
        "unresolved_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "active",
            "rejected"
          ]
        }
      }
    },
    "meetingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_point_id",
        "forward_step_id",
        "backward_step_id",
        "state_id",
        "match_score",
        "rationale"
      ],
      "properties": {
        "meeting_point_id": {
          "type": "string",
          "minLength": 1
        },
        "forward_step_id": {
          "type": "string",
          "minLength": 1
        },
        "backward_step_id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "match_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "from_state_id",
        "to_state_id",
        "basis_step_refs"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "from_state_id": {
          "type": "string",
          "minLength": 1
        },
        "to_state_id": {
          "type": "string",
          "minLength": 1
        },
        "basis_step_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_id",
        "description",
        "evidence_refs"
      ],
      "properties": {
        "contradiction_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
