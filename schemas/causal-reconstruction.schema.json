{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:causal-reconstruction:0.1.0",
  "title": "Causal Reconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "reconstruction_id",
    "observation_id",
    "forward_trace_id",
    "backward_trace_id",
    "claim_level",
    "meeting_points",
    "candidate_path",
    "reconstruction_status",
    "confidence",
    "unresolved_gaps",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "causal-reconstruction"
    },
    "reconstruction_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "forward_trace_id": {
      "type": "string",
      "minLength": 1
    },
    "backward_trace_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_level": {
      "const": "hypothesis"
    },
    "causal_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "meeting_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meetingPoint"
      }
    },
    "candidate_path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathSegment"
      }
    },
    "reconstruction_status": {
      "enum": [
        "converged",
        "partial",
        "no-convergence"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "meetingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_point_id",
        "forward_step_id",
        "backward_step_id",
        "state_id",
        "match_score",
        "rationale",
        "contradictions"
      ],
      "properties": {
        "meeting_point_id": {
          "type": "string",
          "minLength": 1
        },
        "forward_step_id": {
          "type": "string",
          "minLength": 1
        },
        "backward_step_id": {
          "type": "string",
          "minLength": 1
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "match_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "from_state_id",
        "to_state_id",
        "basis_step_refs"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "from_state_id": {
          "type": "string",
          "minLength": 1
        },
        "to_state_id": {
          "type": "string",
          "minLength": 1
        },
        "basis_step_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
