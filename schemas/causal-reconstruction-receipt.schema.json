{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:causal-reconstruction-receipt:0.5.0",
  "title": "Causal Reconstruction Receipt",
  "description": "Final audit-oriented receipt summarizing an end-to-end CTRP causal reconstruction workflow without asserting proven causality.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "record_type",
    "receipt_id",
    "reconstruction_id",
    "hypothesis_id",
    "validation_id",
    "conformance_id",
    "claim_level",
    "final_status",
    "causal_role",
    "confidence",
    "trace_refs",
    "assessment_refs",
    "remaining_uncertainties",
    "issued_at"
  ],

  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },

    "record_type": {
      "const": "causal-reconstruction-receipt"
    },

    "receipt_id": {
      "type": "string",
      "minLength": 1
    },

    "reconstruction_id": {
      "type": "string",
      "minLength": 1
    },

    "hypothesis_id": {
      "type": "string",
      "minLength": 1
    },

    "validation_id": {
      "type": "string",
      "minLength": 1
    },

    "conformance_id": {
      "type": "string",
      "minLength": 1
    },

    "claim_level": {
      "const": "hypothesis"
    },

    "final_status": {
      "enum": [
        "supported",
        "plausible",
        "insufficient-evidence",
        "rejected"
      ]
    },

    "causal_role": {
      "enum": [
        "necessary-and-sufficient",
        "necessary-only",
        "sufficient-only",
        "neither-supported",
        "undetermined"
      ]
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "trace_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "remaining_uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
