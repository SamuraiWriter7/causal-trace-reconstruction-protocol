{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:hypothesis-comparison:0.3.0",
  "title": "Hypothesis Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "comparison_id",
    "reconstruction_id",
    "scoring_method",
    "entries",
    "tie_threshold",
    "selection_margin",
    "decision",
    "compared_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "record_type": {
      "const": "hypothesis-comparison"
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "reconstruction_id": {
      "type": "string",
      "minLength": 1
    },
    "scoring_method": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparisonEntry"
      }
    },
    "tie_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "selection_margin": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "compared_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "comparisonEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "path_coherence",
        "evidence_support",
        "contradiction_penalty",
        "gap_penalty",
        "final_score",
        "rank",
        "rationale"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "path_coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_support": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contradiction_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gap_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "final_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "selected_hypothesis_id",
            "rationale"
          ],
          "properties": {
            "status": {
              "const": "selected"
            },
            "selected_hypothesis_id": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "rationale"
          ],
          "properties": {
            "status": {
              "enum": [
                "ambiguous",
                "insufficient-evidence",
                "all-rejected"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
