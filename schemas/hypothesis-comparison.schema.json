{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:hypothesis-comparison:0.4.0",
  "title": "Hypothesis Comparison",
  "description": "Compares multiple causal hypotheses using structural, evidential, temporal, contradiction, and unresolved-gap factors.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "record_type",
    "comparison_id",
    "reconstruction_id",
    "scoring_method",
    "entries",
    "tie_threshold",
    "selection_margin",
    "decision",
    "compared_at"
  ],

  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },

    "record_type": {
      "const": "hypothesis-comparison"
    },

    "comparison_id": {
      "type": "string",
      "minLength": 1
    },

    "reconstruction_id": {
      "type": "string",
      "minLength": 1
    },

    "scoring_method": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier or description of the scoring method used to compare hypotheses."
    },

    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparisonEntry"
      }
    },

    "tie_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Maximum score margin below which the leading hypotheses are considered ambiguous."
    },

    "selection_margin": {
      "description": "Difference between the rank-1 and rank-2 final scores. Null when only one hypothesis is compared.",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },

    "decision": {
      "$ref": "#/$defs/decision"
    },

    "compared_at": {
      "type": "string",
      "format": "date-time"
    }
  },

  "$defs": {
    "comparisonEntry": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "hypothesis_id",
        "temporal_assessment_id",
        "path_coherence",
        "evidence_support",
        "temporal_consistency",
        "contradiction_penalty",
        "gap_penalty",
        "final_score",
        "rank",
        "rationale"
      ],

      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },

        "temporal_assessment_id": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the temporal precedence assessment associated with this hypothesis."
        },

        "path_coherence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Degree to which the reconstructed causal path is internally coherent."
        },

        "evidence_support": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Degree to which available evidence supports the hypothesis."
        },

        "temporal_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Degree to which the hypothesis satisfies temporal precedence and causal-window constraints."
        },

        "contradiction_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Penalty representing evidence or trace elements that contradict the hypothesis."
        },

        "gap_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Penalty representing unresolved causal or evidential gaps."
        },

        "final_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Implementation-defined aggregate comparison score."
        },

        "rank": {
          "type": "integer",
          "minimum": 1
        },

        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Human- or machine-readable explanation of the comparison result."
        }
      }
    },

    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/selectedDecision"
        },
        {
          "$ref": "#/$defs/nonSelectedDecision"
        }
      ]
    },

    "selectedDecision": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "status",
        "selected_hypothesis_id",
        "rationale"
      ],

      "properties": {
        "status": {
          "const": "selected"
        },

        "selected_hypothesis_id": {
          "type": "string",
          "minLength": 1
        },

        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "nonSelectedDecision": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "status",
        "rationale"
      ],

      "properties": {
        "status": {
          "enum": [
            "ambiguous",
            "insufficient-evidence",
            "all-rejected"
          ]
        },

        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
