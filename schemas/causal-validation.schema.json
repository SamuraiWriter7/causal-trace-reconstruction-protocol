{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-trace-reconstruction-protocol:schema:causal-validation:0.3.0",
  "title": "Causal Validation",
  "description": "Validates a specific reconstructed causal hypothesis using evidence checks, counterfactual tests, temporal precedence assessment, and competing hypotheses.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "record_type",
    "validation_id",
    "reconstruction_id",
    "hypothesis_id",
    "temporal_assessment_id",
    "evidence_checks",
    "counterfactual_tests",
    "competing_hypothesis_refs",
    "conclusion",
    "validated_at"
  ],

  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },

    "record_type": {
      "const": "causal-validation"
    },

    "validation_id": {
      "type": "string",
      "minLength": 1
    },

    "reconstruction_id": {
      "type": "string",
      "minLength": 1
    },

    "hypothesis_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the specific candidate causal hypothesis being validated."
    },

    "comparison_id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional reference to the hypothesis comparison record associated with this validation."
    },

    "temporal_assessment_id": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the temporal precedence assessment for the hypothesis."
    },

    "evidence_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceCheck"
      }
    },

    "counterfactual_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterfactualTest"
      }
    },

    "competing_hypothesis_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "References to alternative causal hypotheses that remain relevant to the validation."
    },

    "conclusion": {
      "$ref": "#/$defs/conclusion"
    },

    "validated_at": {
      "type": "string",
      "format": "date-time"
    }
  },

  "$defs": {
    "evidenceCheck": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "check_id",
        "evidence_ref",
        "assessment",
        "rationale"
      ],

      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },

        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to an evidence item from the source causal observation."
        },

        "assessment": {
          "enum": [
            "supports",
            "neutral",
            "contradicts",
            "unverifiable"
          ]
        },

        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "counterfactualTest": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "test_id",
        "intervention",
        "expected_if_hypothesis_true",
        "observed_or_simulated_result",
        "supports_hypothesis",
        "confidence"
      ],

      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },

        "intervention": {
          "type": "string",
          "minLength": 1,
          "description": "Counterfactual intervention applied to the proposed causal mechanism or condition."
        },

        "expected_if_hypothesis_true": {
          "type": "string",
          "minLength": 1,
          "description": "Expected result under the intervention if the causal hypothesis is correct."
        },

        "observed_or_simulated_result": {
          "type": "string",
          "minLength": 1,
          "description": "Observed, experimentally obtained, or simulated counterfactual result."
        },

        "supports_hypothesis": {
          "type": "boolean"
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },

    "conclusion": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "status",
        "confidence",
        "rationale",
        "blocking_issues"
      ],

      "properties": {
        "status": {
          "enum": [
            "insufficient-evidence",
            "plausible",
            "supported",
            "rejected"
          ]
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Assessment confidence. This value does not represent proof of causality."
        },

        "rationale": {
          "type": "string",
          "minLength": 1
        },

        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
